    "ai": "^7.0.162",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@storybook/addon-mcp": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@wxt-dev/module-react": "^1.2.2",
    "sass": "^1.107.1",
    "storybook": "10.6.5",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "wxt": "^0.21.5"
  }
