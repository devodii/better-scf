{
  "name": "extension",
  "version": "0.1.0",
  "private": true,
  "description": "WXT + React + SCSS Chrome extension for communityfund.stellar.org.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
