{
  "name": "server",
  "version": "0.1.6",
  "private": true,
  "description": "Hono server behind the in-page AI chat.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup --entry.index src/server.ts --out-dir dist --format esm --target node22 --clean",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "probe": "tsx --env-file-if-exists=.env evals/probe.ts",
    "eval": "tsx --env-file=.env evals/run.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@hono/node-server": "^2.1.6",
    "ai": "^7.0.162",
    "dayjs": "^1.11.23",
    "hono": "^4.13.16",
    "ioredis": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "shared": "workspace:*",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
