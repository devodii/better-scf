# Anthropic key. Server side only, never committed, never bundled into the extension.
ANTHROPIC_API_KEY=
# Comma separated chrome-extension ids allowed to call the server (include the dev id).
ALLOWED_EXTENSION_IDS=
PORT=8787
DAILY_CAP_PER_CLIENT=300
BURST_PER_MINUTE=24
# Optional, see docs/build-spec.md section 7.6 (defaults are applied by env.ts):
# MODEL=
# GLOBAL_DAILY_CAP=3000
# NODE_ENV=development
