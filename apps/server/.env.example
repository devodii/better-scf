# Anthropic key. Server side only, never committed, never bundled into the extension.
ANTHROPIC_API_KEY=
# Comma separated chrome-extension ids allowed to call the server (include the dev id). Optional: the pinned release id is always allowed.
ALLOWED_EXTENSION_IDS=
PORT=8787
# Questions one person may ask per day. Required, set per environment (Railway in production).
DAILY_CAP_PER_CLIENT=300
# Optional:
# MODEL=
# NODE_ENV=development
