{
  "name": "better-scf",
  "version": "0.1.0",
  "private": true,
  "description": "A reviewer-grade UX layer on communityfund.stellar.org, plus the small server behind its AI chat.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "tokens": "tsx scripts/scrape-tokens.ts",
    "tokens:attach": "BSCF_CDP=http://127.0.0.1:9333 tsx scripts/scrape-tokens.ts round=https://communityfund.stellar.org/dashboard/award-rounds/recxrSMYwAl8vcglg submission=https://communityfund.stellar.org/dashboard/submissions/recVDIsC4yhuv9oun award-rounds=https://communityfund.stellar.org/dashboard/award-rounds",
    "recon": "tsx scripts/recon.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^22.20.5",
    "playwright": "^1.64.1",
    "shared": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
