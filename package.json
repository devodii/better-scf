{
  "name": "better-scf",
  "version": "0.1.0",
  "private": true,
  "description": "A reviewer-grade UX layer on communityfund.stellar.org, plus the small server behind its AI chat.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:dev": "pnpm --filter extension build:dev",
    "build:prod": "pnpm --filter extension build:prod",
    "lint": "biome check --vcs-enabled=true --vcs-client-kind=git --vcs-use-ignore-file=true . && prettier --check .",
    "format": "biome check --write --vcs-enabled=true --vcs-client-kind=git --vcs-use-ignore-file=true . && prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "storybook": "pnpm --filter extension storybook",
    "build-storybook": "pnpm --filter extension build-storybook"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "prettier": "^3.9.10"
  }
}
