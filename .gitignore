# Dependencies restored by pnpm (root and each workspace package); pnpm-lock.yaml stays tracked.
node_modules/

# WXT build output (unpacked extension and zips), written by `wxt build` / `wxt zip`.
/apps/extension/output/

# WXT generated types and tsconfig, written by `wxt prepare`.
/apps/extension/.wxt/

# Static Storybook build, written by `pnpm build-storybook`.
/apps/extension/storybook-static/

# Build output of the server, written by tsup (`pnpm --filter server build`).
/apps/server/dist/

# Vite build output of the landing page, written by `pnpm --filter web build`.
/apps/web/dist/

# Local secrets and machine config; each app commits a .env.example instead.
.env
.env.*
!.env.example

# Playwright MCP session logs, written to the directory the session was launched from.
.playwright-mcp/

# Playwright MCP screenshots; the tooling is told to prefix every file name with pw-shot-.
pw-shot-*.png

# Test coverage reports regenerated by each run (root and each package).
/coverage/
/apps/*/coverage/
/packages/*/coverage/

# macOS Finder metadata.
.DS_Store
# Local contact sheet of the verification screenshots, regenerated with them.
docs/verification/index.html
apps/server/evals/results/
apps/server/evals/*.out
